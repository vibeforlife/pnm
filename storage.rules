rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /groups/{groupId}/nights/{nightIndex}/{photoId} {
      allow read: if photoId.matches('.*\\.jpg$');

      allow create: if photoId.matches('.*\\.jpg$')
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType == 'image/jpeg';

      allow update: if photoId.matches('.*\\.jpg$')
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType == 'image/jpeg';

      allow delete: if photoId.matches('.*\\.jpg$');
    }
  }
}
